# Bedrock Mantle settings for the VG Copilot demo.
# AWS credentials come from the named AWS profile; never add access keys here.
AWS_PROFILE=bedrock-role
AWS_REGION=ap-south-1
VG_BOT_MANTLE_BASE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1
VG_BOT_MANTLE_PROJECT=default
VG_BOT_MANTLE_REGION=ap-south-1
VG_BOT_MANTLE_MODEL=minimax.minimax-m2.5
# VG_BOT_MANTLE_TIMEOUT=120

# Generic OIDC (Auth0 today; swap issuer to reuse in another app).
APP_BASE_URL=http://localhost:8000
AUTH0_DOMAIN=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_ISSUER=https://YOUR_TENANT.us.auth0.com
SESSION_SECRET=change-me-to-a-long-random-string
